{
  "name": "loom-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Tauri bundler for the Loom desktop app (macOS app, Ubuntu deb/AppImage, Windows NSIS); task-local CLI, no global install",
  "scripts": {
    "tauri": "tauri",
    "test": "node --test \"scripts/portable/test/*.test.mjs\"",
    "stage": "node scripts/package.mjs stage --profile release",
    "stage:debug": "node scripts/package.mjs stage --profile debug",
    "check": "node scripts/package.mjs check",
    "verify": "node scripts/package.mjs verify",
    "build:app": "node scripts/package.mjs bundle",
    "build:app:debug": "node scripts/package.mjs bundle --debug",
    "dist": "node scripts/package.mjs dist",
    "dist:debug": "node scripts/package.mjs dist --debug"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  },
  "engines": {
    "node": ">=24"
  }
}
