{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalRequestedPayload",
  "description": "`core.approval_requested` payload (only when approvals are enabled by policy, F1).",
  "type": "object",
  "properties": {
    "approval_id": {
      "description": "Approval id.",
      "type": "string"
    },
    "display": {
      "description": "Domain display object (`approval_binding().display`).",
      "default": null
    },
    "kind": {
      "description": "Kind.",
      "$ref": "#/$defs/ApprovalKind"
    },
    "method": {
      "description": "Method.",
      "type": "string"
    },
    "presence": {
      "description": "Presence check required, if any.",
      "anyOf": [
        {
          "$ref": "#/$defs/PresenceMethod"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_by": {
      "description": "Requesting client.",
      "type": "string"
    },
    "risk": {
      "description": "Risk.",
      "$ref": "#/$defs/Risk"
    },
    "scope": {
      "description": "Scope.",
      "$ref": "#/$defs/ApprovalScope"
    },
    "target": {
      "description": "Target description.",
      "type": [
        "string",
        "null"
      ]
    },
    "use_by_wall_ns": {
      "description": "Must be used before (wall ns).",
      "$ref": "#/$defs/U64"
    }
  },
  "required": [
    "approval_id",
    "kind",
    "risk",
    "method",
    "scope",
    "use_by_wall_ns",
    "requested_by"
  ],
  "$defs": {
    "ApprovalKind": {
      "description": "What is being approved.",
      "oneOf": [
        {
          "description": "A single write.",
          "type": "string",
          "const": "write"
        },
        {
          "description": "Start of a job.",
          "type": "string",
          "const": "job_start"
        },
        {
          "description": "Relaxing a policy setting.",
          "type": "string",
          "const": "policy_relax"
        },
        {
          "description": "Unlocking a default-blocked item.",
          "type": "string",
          "const": "unlock"
        },
        {
          "description": "Test plan bundle (E4).",
          "type": "string",
          "const": "test_plan"
        },
        {
          "description": "Run plan bundle (E4).",
          "type": "string",
          "const": "run_plan"
        }
      ]
    },
    "ApprovalScope": {
      "description": "Scope of an approval (only used when approvals are enabled).",
      "oneOf": [
        {
          "description": "One use.",
          "type": "string",
          "const": "once"
        },
        {
          "description": "Several uses until a deadline.",
          "type": "object",
          "properties": {
            "session": {
              "type": "object",
              "properties": {
                "max_uses": {
                  "description": "Maximum uses.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "until_mono_ns": {
                  "description": "Host monotonic deadline (ns).",
                  "anyOf": [
                    {
                      "$ref": "#/$defs/U64"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "max_uses"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "session"
          ]
        },
        {
          "description": "Bound to a test session (E4 bundle approval).",
          "type": "object",
          "properties": {
            "test_session": {
              "type": "object",
              "properties": {
                "session_id": {
                  "description": "Session id.",
                  "type": "string"
                }
              },
              "required": [
                "session_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "test_session"
          ]
        },
        {
          "description": "Bound to a run (E4).",
          "type": "object",
          "properties": {
            "run": {
              "type": "object",
              "properties": {
                "run_id": {
                  "description": "Run id.",
                  "type": "string"
                }
              },
              "required": [
                "run_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "run"
          ]
        }
      ]
    },
    "PresenceMethod": {
      "description": "How a human presence check was performed (E9; only when turned on).",
      "oneOf": [
        {
          "description": "Short code shown only to viewers (mis-click guard, not proof of a human).",
          "type": "string",
          "const": "code"
        },
        {
          "description": "WebAuthn assertion with a registered credential.",
          "type": "string",
          "const": "webauthn"
        },
        {
          "description": "Out-of-band code.",
          "type": "string",
          "const": "oob"
        }
      ]
    },
    "Risk": {
      "description": "Risk class (D6). Under F1 every class runs automatically by default; the class is still\nshown and recorded.",
      "oneOf": [
        {
          "description": "Observe only.",
          "type": "string",
          "const": "R0"
        },
        {
          "description": "Reversible, low risk write.",
          "type": "string",
          "const": "R1"
        },
        {
          "description": "State-changing write.",
          "type": "string",
          "const": "R2"
        },
        {
          "description": "Dangerous (security access, actuators, periodic TX …).",
          "type": "string",
          "const": "R3"
        },
        {
          "description": "Irreversible / high risk.",
          "type": "string",
          "const": "R4"
        }
      ]
    },
    "U64": {
      "description": "Unsigned 64-bit integer as canonical decimal string (no sign, no leading zero).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    }
  }
}
