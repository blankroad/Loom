          "description": "Plan digest when the write belongs to an approved plan.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "description": "Request id (write rows).",
          "type": "string"
        },
        "write_class": {
          "description": "Write class.",
          "$ref": "#/$defs/WriteClass"
        }
      },
      "required": [
        "call_id",
        "request_id",
        "write_class",
        "op",
        "origin",
        "deadline_mono_ns"
      ]
    },
    "WriteClass": {
      "description": "Write class (A1).",
      "oneOf": [
        {
          "description": "One request through the full pipeline.",
          "type": "string",
          "const": "request"
        },
        {
          "description": "Job: only start/update/renew/stop are gated.",
          "type": "string",
          "const": "job"
        },
        {
          "description": "Interactive input stream (lease checked once).",
          "type": "string",
          "const": "interactive"
        }
      ]
    }
  }
}
